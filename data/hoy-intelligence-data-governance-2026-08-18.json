  "retention_policy_gate": {
    "approved": false,
    "requirements": ["purpose-specific retention period", "automatic deletion or irreversible aggregation path", "review interval", "backup deletion treatment", "documented exception handling"]
  },
  "commercialization_gate": {
    "enabled": false,
    "all_required": [
      "event inventory complete",
      "lawful basis validated for production collection",
      "transparency obligations implemented",
      "consent or preference controls implemented where required",
      "retention and deletion policy approved and implemented",
      "aggregation threshold numerically defined and tested",
      "sparse and differencing attacks tested",
      "pseudonymous identifiers removed from customer-facing datasets",
      "row-level journeys unavailable to customers",
      "re-identification contract prohibition in customer terms",
      "security review approved",
      "legal review approved",
      "data lineage documented from source event to customer metric"
    ],
    "fail_closed_rule": "Any missing, pending or failed requirement keeps commercialization_allowed=false."
  },
